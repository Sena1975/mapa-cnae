 <?php
 namespace App\Http\Controllers\Prospect;

 use App\Models\Prospect\ClienteExterno;
 use App\Http\Requests\ListExternalClientsRequest;
 use App\Http\Resources\ClienteExternoResource;
 use Illuminate\Http\Request;

 class ClienteExternoController
 {
-    public function listInBounds(Request $req)
-    {
-        // ...
-    }
+    public function listInBounds(ListExternalClientsRequest $req)
+    {
+        $data   = $req->validated();
+        $bounds = is_string($data['bounds']) ? json_decode($data['bounds'], true) : $data['bounds'];
+        $n = (float)$bounds['n']; $s = (float)$bounds['s'];
+        $e = (float)$bounds['e']; $w = (float)$bounds['w'];
+
+        $per   = $data['per_page'] ?? 50;
+        $sort  = $data['sort'] ?? 'enriched_at';
+
+        // Centro: fornecido ou média dos bounds
+        $centerLat = $data['center']['lat'] ?? (($n + $s) / 2);
+        $centerLng = $data['center']['lng'] ?? (($e + $w) / 2);
+        $cosLat0   = cos(deg2rad($centerLat)); // constante para dist2
+
+        $q = ClienteExterno::query()
+            ->inBounds($n, $s, $e, $w)
+            ->filterLocalidade($data['cidade'] ?? null, $data['uf'] ?? null)
+            ->when(!empty($data['cnaes']), fn($q) => $q->filterCnaes($data['cnaes']));
+
+        // Ordenação por distância (aproximação dist2) quando solicitado
+        if (in_array($sort, ['distance','-distance'])) {
+            $dist2Expr = '((latitude - ?) * (latitude - ?)) + (((longitude - ?) * ?) * ((longitude - ?) * ?))';
+            $bindings = [$centerLat, $centerLat, $centerLng, $cosLat0, $centerLng, $cosLat0];
+            $dir = $sort === 'distance' ? 'asc' : 'desc';
+            $q->addSelectRaw($dist2Expr.' as dist2', $bindings)->orderByRaw('dist2 '.$dir);
+        } else {
+            $sortMap = [
+                'enriched_at'  => ['enriched_at','desc'],
+                '-enriched_at' => ['enriched_at','asc'],
+                'nome'         => ['nome_fantasia','asc'],
+                '-nome'        => ['nome_fantasia','desc'],
+            ];
+            [$col,$dir] = $sortMap[$sort] ?? ['enriched_at','desc'];
+            $q->orderBy($col, $dir);
+        }
+
+        // Passa o center para o Resource calcular distance_km (Haversine) com precisão
+        request()->merge(['center' => ['lat' => $centerLat, 'lng' => $centerLng]]);
+
+        return ClienteExternoResource::collection($q->paginate($per));
+    }

     public function countInBounds(Request $req)
     {
         if ($req->boolean('all')) {
             return response()->json(['count' => ClienteExterno::query()->count()]);
         }
         $bounds = $req->query('bounds');
         if (is_string($bounds)) $bounds = json_decode($bounds, true);
         if (!is_array($bounds) || !isset($bounds['n'],$bounds['s'],$bounds['e'],$bounds['w'])) {
             return response()->json(['message' => 'bounds inválido'], 422);
         }
         $n=(float)$bounds['n']; $s=(float)$bounds['s']; $e=(float)$bounds['e']; $w=(float)$bounds['w'];
         $q = ClienteExterno::query()->inBounds($n,$s,$e,$w)
             ->filterLocalidade($req->query('cidade'), $req->query('uf'));
         $cnaes = (array) $req->query('cnaes', []);
-        if (!empty($cnaes)) $q->whereIn('codigo_cnae', $cnaes);
+        if (!empty($cnaes)) $q->filterCnaes($cnaes);
         return response()->json(['count' => $q->count()]);
     }
 }
